{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },

  "mcp": {
    "motion": {
      "type": "remote",
      "url": "https://mcp.motion.dev",
      "enabled": true
    },

    "motion-plus": {
      "type": "remote",
      "url": "https://mcp.motion.dev/plus",
      "enabled": true
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}

